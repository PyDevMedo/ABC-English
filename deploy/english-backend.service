[Unit]
Description=My English Journey FastAPI Backend Service
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/english-journey/backend
EnvironmentFile=/var/www/english-journey/backend/.env
ExecStart=/var/www/english-journey/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 4
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
