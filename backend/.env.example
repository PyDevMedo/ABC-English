# ==============================================================
# 🚀 ملف إعدادات منصة ABC لتعليم الإنجليزية للأطفال
# ==============================================================

# 1. إعدادات بوت Telegram لإدارة المنصة:
# ضع هنا توكن البوت الذي حصلت عليه من @BotFather
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"

# ضع هنا الآيدي الرقمي لحسابك في تليجرام (يمكن معرفته عبر إرسال رسالة لبوت @userinfobot)
# إذا كان هناك أكثر من مسؤول، افصل بينهم بفاصلة (مثال: 12345678,98765432)
TELEGRAM_ADMIN_IDS="12345678"

# 2. إعدادات المنصة:
PROJECT_NAME="ABC English"
SECRET_KEY="abc-super-secret-production-key-2026-xyz"
API_V1_STR="/api/v1"

# 3. قاعدة البيانات:
# افتراضياً SQLite للتشغيل السريع بدون سيرفر خارجي:
DATABASE_URL="sqlite+aiosqlite:///./english_journey.db"
# عند النشر على خادم VPS مع PostgreSQL، يمكنك استخدام السطر التالي:
# DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/abc_db"

# 4. مسارات التخزين:
UPLOAD_DIR="./uploads"
STATIC_AUDIO_DIR="./static/audio"

# 5. رابط الباك إند للاستخدام مع Vercel:
# عند رفع الفرونت إند على Vercel، ضع رابط سيرفر الـ API الخاص بك هنا:
VITE_API_BASE_URL="http://localhost:8000"

# 6. إعدادات التقييم الذكي:
PASSING_SCORE_DEFAULT=80
MIN_PRONUNCIATION_CONFIDENCE=0.40
NOISY_AUDIO_RMS_THRESHOLD=0.015
WEAKNESS_DETECTION_THRESHOLD=3
