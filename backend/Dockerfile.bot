FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir greenlet && \
    pip install --no-cache-dir -r requirements.txt

COPY . .

# Least Privilege Principle: Create non-root unprivileged service user
RUN groupadd -g 10001 botgroup && \
    useradd -u 10001 -g botgroup -s /bin/bash -m botuser && \
    mkdir -p /app/uploads /app/static/audio && \
    chown -R botuser:botgroup /app

USER botuser

CMD ["python", "bot/bot_main.py"]
